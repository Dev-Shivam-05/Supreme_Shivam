# ============================================================
#  Shivam Bhadoriya — Portfolio
#  Copy this file to `.env.local` and fill in what you need.
#
#  The site runs fine with everything blank. Each feature turns
#  on the moment you provide its variables — nothing else to change.
# ============================================================

# --- Database: MongoDB --------------------------------------
# Turns on: contact-form lead storage, the analytics pipeline,
#           the public /stats page, and the /admin dashboard data.
# Free cluster: https://www.mongodb.com/atlas  (use the SRV string)
MONGODB_URI=

# --- Email: SMTP (via Nodemailer) ---------------------------
# Turns on: emailing contact-form leads to you.
# Works with a Gmail App Password, Resend SMTP, Mailgun, Postmark, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "from" address (defaults to SMTP_USER if left blank)
SMTP_FROM=
# Where lead notifications are delivered (defaults to your public email)
CONTACT_TO=

# --- Admin dashboard: /admin --------------------------------
# Turns on: the analytics command center + leads pipeline login.
# ADMIN_PASSWORD  -> the password you'll type at /admin
# ADMIN_SECRET    -> a long random string used to sign the session cookie
#                    (generate: `openssl rand -hex 32`)
ADMIN_PASSWORD=
ADMIN_SECRET=

# --- Optional --------------------------------------------------
# Public site origin for canonical URLs when you move to a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
